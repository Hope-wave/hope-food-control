PORT=3000
SESSION_SECRET=troque-para-uma-chave-segura
# Cookie seguro (HTTPS). Na Vercel fica ligado automaticamente (env VERCEL). Em outro host HTTPS, use SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SECURE=true

# WhatsApp do botão "Precisa de ajuda?": país + DDD + número, só dígitos (ex.: 5511912345678).
# Se ficar vazio, o botão não aparece.
SUPPORT_WHATSAPP_NUMBER=

# Login simples armazenado no sistema (backend)
ADMIN_USER=
ADMIN_PASSWORD=
VOLUNTEER_USER=
VOLUNTEER_PASSWORD=

# Firebase
# Escolha apenas UM formato:
# 1) Caminho para arquivo da chave de serviço:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# 2) JSON da chave em uma unica linha:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

FIREBASE_PROJECT_ID=seu-projeto-firebase

# Deploy serverless (ex.: Vercel): defina FIREBASE_SERVICE_ACCOUNT_JSON para sessoes e dados persistirem entre instancias.
